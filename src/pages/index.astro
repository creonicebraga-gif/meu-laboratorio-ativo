---
// Arquivo com sintaxe corrigida e testada
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <title>Bunker de Alan Turing</title>
    <style>
        body { background-color: #0f0f1a; color: #e2e8f0; font-family: sans-serif; padding: 40px; }
        .caixa { background-color: #1e1e38; padding: 30px; border-radius: 12px; max-width: 600px; margin: 0 auto; }
        textarea { width: 100%; height: 100px; background-color: #0d0d16; color: #a6e3a1; font-family: monospace; padding: 10px; box-sizing: border-box; }
        button { background-color: #4f46e5; color: white; border: none; padding: 12px 20px; border-radius: 6px; cursor: pointer; margin-top: 10px; font-weight: bold; }
        .feedback { margin-top: 15px; padding: 15px; border-radius: 6px; display: none; font-weight: bold; }
    </style>
</head>
<body>

    <div class="caixa">
        <h2>🔐 O Bunker de Alan Turing</h2>
        <p>Sua Missão: Complete a função para retornar o texto de trás para frente!</p>
        
        <textarea id="txtAluno" is:raw>function decifrarMensagem(texto) {
    return texto;
}</textarea>
        
        <button id="btnChecar">🚀 Validar Algoritmo</button>
        <div id="divFeedback" class="feedback"></div>
    </div>

    <script>
        let erros = 0;
        const btn = document.getElementById('btnChecar');
        const txt = document.getElementById('txtAluno');
        const fd = document.getElementById('divFeedback');

        btn?.addEventListener('click', () => {
            if (fd) fd.style.display = "block";
            try {
                const codigoTxt = txt ? txt.value : '';
                const funcao = new Function(codigoTxt + "; return decifrarMensagem;");
                const executar = funcao();
                
                if (executar("AMGINE") === "ENIGMA" && fd) {
                    fd.style.backgroundColor = "#1e3a1e";
                    fd.style.color = "#a6e3a1";
                    fd.innerHTML = "✅ SUCESSO! Você ganhou a Medalha Alan Turing! 🏅";
                    erros = 0;
                } else if (fd) {
                    erros++;
                    if (erros < 3) {
                        fd.style.backgroundColor = "#3a3a1e";
                        fd.style.color = "#f9e2af";
                        fd.innerHTML = "❌ Código incorreto. Tentativas: " + erros + "/3";
                    } else {
                        fd.style.backgroundColor = "#2e2e42";
                        fd.style.color = "#f9e2af";
                        fd.innerHTML = "💡 *MENTORIA* 💡<br><br>Use: <code>return texto.split('').reverse().join('');</code>";
                    }
                }
            } catch (e) {
                erros++;
                if (fd) {
                    fd.style.backgroundColor = "#3a1e1e";
                    fd.style.color = "#f38ba8";
                    fd.innerHTML = "💥 ERRO DE SINTAXE! Verifique as chaves.";
                }
            }
        });
    </script>
</body>
</html>