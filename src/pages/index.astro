---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
---

<Layout title="Laboratório dos Mestres da Lógica">
  <main style="max-width: 800px; margin: 0 auto; padding: 20px; color: #e2e8f0;">
    <h1 style="text-align: center; color: #818cf8; margin-top: 40px;">Duolingo da TI - Laboratório Ativo</h1>
    
    <div class="bunker-turing" style="background-color: #16162a; padding: 25px; border-radius: 12px; border: 1px solid #2d2d44; margin-top: 20px;">
      <h2>🔐 O Bunker de Alan Turing</h2>
      <p style="color: #94a3b8;"><strong>Sua Missão:</strong> Complete a função para retornar o texto de trás para frente!</p>
      
      <textarea id="txtAluno" rows="6" style="width: 100%; background-color: #0d0d16; color: #a6e3a1; font-family: monospace; padding: 10px; box-sizing: border-box; border-radius: 6px;">function decifrarMensagem(texto) {
    return texto;
}</textarea>
      
      <button id="btnValidarTuring" style="background-color: #4f46e5; color: white; border: none; padding: 12px 20px; border-radius: 6px; cursor: pointer; font-weight: bold; margin-top: 15px;">🚀 Validar Algoritmo</button>
      <div id="divFeedback" style="display: none; margin-top: 15px; padding: 15px; border-radius: 6px; font-weight: bold;"></div>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../lib/supabaseClient';

  const txt = document.getElementById('txtAluno') as HTMLTextAreaElement;
  const fd = document.getElementById('divFeedback') as HTMLDivElement;
  const btn = document.getElementById('btnValidarTuring');

  let erros = 0;

  btn?.addEventListener('click', async () => {
    if (fd) fd.style.display = "block";

    try {
      const codigoTxt = txt ? txt.value : '';
      const funcao = new Function(codigoTxt + "; return decifrarMensagem;");
      const executar = funcao();
      
      if (executar("AMGINE") === "ENIGMA") {
        if (fd) {
          fd.style.backgroundColor = "#1e3a1e";
          fd.style.color = "#a6e3a1";
          fd.innerHTML = "✅ SUCESSO! Você ganhou a Medalha Alan Turing! 🏅";
        }
        erros = 0;

        await supabase.from('historico_medalhas').insert([
          { 
            aluno_id: "aluno_teste_01", 
            medalha_nome: "Decifrador da Enigma", 
            curso_origem: "Blog_Astro_Principal" 
          }
        ]);

      } else {
        erros++;
        if (fd) {
          fd.style.backgroundColor = "#3a3a1e";
          fd.style.color = "#f9e2af";
          fd.innerHTML = ❌ Código incorreto. Tentativas: ${erros}/3;
        }
      }
    } catch (erro) {
      erros++;
      if (fd) {
        fd.style.backgroundColor = "#3a1e1e";
        fd.style.color = "#f38ba8";
        fd.innerHTML = "💥 ERRO DE SINTAXE! Verifique as chaves.";
      }
    }
  });
</script>